# Effect binaries are ZOOM's and are not redistributed here. Fetch them with
# tools/download-effects.py, or point the app at your own library.
app/bundle-assets/
app/artwork/
*.ZDL
*.zip

# Your pedal's contents are yours.
*-patches-*.json
backups/

# Captured hardware fixtures the tests use when present.
app/browser-handshake-success-*.json
app/*.bin

# Built probes
tools/macos-bt-probe/sdp-dump
tools/macos-bt-probe/rfcomm-listen
tools/macos-bt-probe/bt-kick
tools/macos-bt-probe/bt-release

.DS_Store
__pycache__/
*.pyc

# The reverse-engineering tree: ZOOM firmware and effect binaries, the extracted
# StompShare app, the pedal's Apple authentication certificate, and the author's
# own pedal contents. None of it is redistributable -- see NOTICE.md. It is also
# its own git repository, so without this an `add -A` embeds a gitlink here.
re-files/

# Written by the Pages workflow at deploy time, never by hand. A stale one
# committed here would ship in the iOS bundle and be read as the live version.
app/version.txt

# Internal working notes and AI memory, not part of the published project.
memory/

# Xcode output. iosapp/project.yml is the source of truth; `xcodegen generate`
# rebuilds the .xcodeproj and its Info.plist from it.
iosapp/**/*.xcodeproj/
iosapp/*.xcodeproj/
iosapp/**/Generated-Info.plist
iosapp/**/DerivedData/
iosapp/**/build/
